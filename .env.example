# MySQL connection
# Hostinger: use the host shown in hPanel -> Databases (e.g. srv1234.hstgr.io or an IP)
# and add your server/PC IP under "Remote MySQL" before connecting from outside Hostinger.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=satta_next
DB_USERNAME=root
DB_PASSWORD=

# Cloud MySQL (Aiven, TiDB…) needs an encrypted connection: set DB_SSL=true.
# If the provider uses its own CA certificate and the connection fails with a certificate error, also set DB_SSL_VERIFY=false.
DB_SSL=false

# Timezone the DB stores created_at/updated_at in. Laravel default is UTC, keep +00:00
# if you reuse the existing Laravel database.
DB_TIMEZONE=+00:00

# Long random string used to sign admin sessions (generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL used for canonical links and sitemap
SITE_URL=http://localhost:3000

# Where uploaded images (ads, OG images, logo) are stored on disk
UPLOAD_DIR=./storage/uploads

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
